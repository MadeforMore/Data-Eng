--Count days in each month

SELECT
    YEAR_NUMBER,
    MONTH_NAME,
    COUNT(*) AS TOTAL_DAYS
FROM DIM_DATE
WHERE YEAR_NUMBER = 2025
GROUP BY YEAR_NUMBER, MONTH_NUMBER, MONTH_NAME
ORDER BY MONTH_NUMBER;

---Count days in each quarter
SELECT
    YEAR_NUMBER,
    QUARTER_NUMBER,
    COUNT(*) AS TOTAL_DAYS
FROM DIM_DATE
GROUP BY YEAR_NUMBER, QUARTER_NUMBER
ORDER BY YEAR_NUMBER, QUARTER_NUMBER;

--Find total weekends and weekdays
SELECT
    COUNT_IF(IS_WEEKEND) AS WEEKEND_DAYS,
    COUNT_IF(NOT IS_WEEKEND) AS WEEKDAYS
FROM DIM_DATE;




