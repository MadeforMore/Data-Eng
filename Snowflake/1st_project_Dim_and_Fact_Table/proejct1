--creating the Main Fact table 

CREATE TABLE FACT_SALES (

    SALES_KEY NUMBER(12,0) IDENTITY(1,1),

    ORDER_ID NUMBER(12,0) NOT NULL,

    ORDER_LINE_NUMBER NUMBER(5,0) NOT NULL,

    CUSTOMER_KEY NUMBER(10,0) NOT NULL,

    PRODUCT_KEY NUMBER(10,0) NOT NULL,

    DATE_KEY NUMBER(8,0) NOT NULL,

    LOCATION_KEY NUMBER(10,0) NOT NULL,

    PAYMENT_KEY NUMBER(10,0) NOT NULL,

    QUANTITY NUMBER(10,0) NOT NULL,

    UNIT_PRICE NUMBER(12,2) NOT NULL,

    DISCOUNT_AMOUNT NUMBER(12,2)
        DEFAULT 0 NOT NULL,

    TOTAL_AMOUNT NUMBER(12,2) NOT NULL,

    CREATED_AT TIMESTAMP_NTZ
        DEFAULT CURRENT_TIMESTAMP(),

    CONSTRAINT PK_FACT_SALES
        PRIMARY KEY (SALES_KEY),

    CONSTRAINT UQ_ORDER_LINE
        UNIQUE (ORDER_ID, ORDER_LINE_NUMBER),

    CONSTRAINT FK_SALES_CUSTOMER
        FOREIGN KEY (CUSTOMER_KEY)
        REFERENCES DIM_CUSTOMER(CUSTOMER_KEY),

    CONSTRAINT FK_SALES_PRODUCT
        FOREIGN KEY (PRODUCT_KEY)
        REFERENCES DIM_PRODUCT(PRODUCT_KEY),

    CONSTRAINT FK_SALES_DATE
        FOREIGN KEY (DATE_KEY)
        REFERENCES DIM_DATE(DATE_KEY),

    CONSTRAINT FK_SALES_LOCATION
        FOREIGN KEY (LOCATION_KEY)
        REFERENCES DIM_LOCATION(LOCATION_KEY),

    CONSTRAINT FK_SALES_PAYMENT
        FOREIGN KEY (PAYMENT_KEY)
        REFERENCES DIM_PAYMENT(PAYMENT_KEY),

    CONSTRAINT CHK_QUANTITY
        CHECK (QUANTITY > 0),

    CONSTRAINT CHK_DISCOUNT
        CHECK (DISCOUNT_AMOUNT >= 0),

    CONSTRAINT CHK_TOTAL
        CHECK (TOTAL_AMOUNT = (QUANTITY * UNIT_PRICE) - DISCOUNT_AMOUNT) 

);


