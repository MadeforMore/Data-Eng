---creating the DIM_DATE table

CREATE TABLE DIM_DATE (
    DATE_KEY NUMBER(8,0) NOT NULL,
    FULL_DATE DATE NOT NULL,
    DAY_OF_MONTH NUMBER(2,0),
    DAY_NAME VARCHAR(10),
    DAY_OF_WEEK NUMBER(1,0),
    WEEK_OF_YEAR NUMBER(2,0),
    ISO_YEAR NUMBER(4,0),
    MONTH_NUMBER NUMBER(2,0),
    MONTH_NAME VARCHAR(20),
    QUARTER_NUMBER NUMBER(1,0),
    YEAR_NUMBER NUMBER(4,0),
    IS_WEEKEND BOOLEAN,

    CONSTRAINT PK_DIM_DATE
    PRIMARY KEY (DATE_KEY)
);

-- inserting the values in the date table (automted date)
INSERT INTO DIM_DATE (
    DATE_KEY,
    FULL_DATE,
    DAY_OF_MONTH,
    DAY_NAME,
    DAY_OF_WEEK,
    WEEK_OF_YEAR,
    ISO_YEAR,
    MONTH_NUMBER,
    MONTH_NAME,
    QUARTER_NUMBER,
    YEAR_NUMBER,
    IS_WEEKEND
)

WITH DATE_SERIES AS (

    SELECT
        DATEADD(               --- DATEADD() --> It adds one day to the starting date.
            DAY,
            ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1,    -- ROW_NUMBER() --> We use these numbers to calculate each calendar date. ROW_NUMBER() produces consecutive row numbers.
            '2025-01-01'::DATE
        ) AS CALENDAR_DATE

    FROM TABLE(GENERATOR(ROWCOUNT => 730))   -- GENERATOR() This creates 730 rows for our date generation process.


)

SELECT
    TO_NUMBER(TO_CHAR(CALENDAR_DATE, 'YYYYMMDD')),
    CALENDAR_DATE,
    DAY(CALENDAR_DATE),

    DECODE(
        DAYOFWEEKISO(CALENDAR_DATE),              ---> We use the ISO version because its weekday numbering is consistent and does not depend on Snowflake's session settings.
        1, 'Monday',
        2, 'Tuesday',
        3, 'Wednesday',
        4, 'Thursday',
        5, 'Friday',
        6, 'Saturday',
        7, 'Sunday'
    ),

    DAYOFWEEKISO(CALENDAR_DATE),
    WEEKISO(CALENDAR_DATE),
    YEAROFWEEKISO(CALENDAR_DATE),
    MONTH(CALENDAR_DATE),
    TO_CHAR(CALENDAR_DATE, 'MMMM'),
    QUARTER(CALENDAR_DATE),
    YEAR(CALENDAR_DATE),

    DAYOFWEEKISO(CALENDAR_DATE) IN (6, 7)

FROM DATE_SERIES;


