--Load data using JOINs
SELECT

    S.ORDER_ID,
    S.ORDER_LINE_NUMBER,

    C.CUSTOMER_KEY,
    P.PRODUCT_KEY,
    D.DATE_KEY,
    L.LOCATION_KEY,
    PM.PAYMENT_KEY,

    S.QUANTITY,
    S.UNIT_PRICE,
    S.DISCOUNT_AMOUNT,
    S.TOTAL_AMOUNT

FROM (

    VALUES

    (1001, 1, 'C101', 'P101', '2025-01-10'::DATE,
     'L101', 'PAY101', 1, 55000.00, 5000.00, 50000.00),

    (1001, 2, 'C101', 'P103', '2025-01-10'::DATE,
     'L101', 'PAY101', 2, 799.00, 0.00, 1598.00),

    (1002, 1, 'C102', 'P102', '2025-02-15'::DATE,
     'L102', 'PAY102', 1, 75000.00, 5000.00, 70000.00),

    (1003, 1, 'C103', 'P104', '2025-03-20'::DATE,
     'L104', 'PAY105', 1, 4500.00, 500.00, 4000.00),

    (1004, 1, 'C104', 'P105', '2025-04-05'::DATE,
     'L101', 'PAY106', 2, 2500.00, 500.00, 4500.00),

    (1005, 1, 'C105', 'P106', '2025-05-12'::DATE,
     'L108', 'PAY108', 1, 3500.00, 0.00, 3500.00)

) AS S (

    ORDER_ID,
    ORDER_LINE_NUMBER,
    CUSTOMER_ID,
    PRODUCT_ID,
    ORDER_DATE,
    LOCATION_ID,
    PAYMENT_ID,
    QUANTITY,
    UNIT_PRICE,
    DISCOUNT_AMOUNT,
    TOTAL_AMOUNT

)

JOIN DIM_CUSTOMER C
    ON S.CUSTOMER_ID = C.CUSTOMER_ID

JOIN DIM_PRODUCT P
    ON S.PRODUCT_ID = P.PRODUCT_ID

JOIN DIM_DATE D
    ON S.ORDER_DATE = D.FULL_DATE

JOIN DIM_LOCATION L
    ON S.LOCATION_ID = L.LOCATION_ID

JOIN DIM_PAYMENT PM
    ON S.PAYMENT_ID = PM.PAYMENT_ID

WHERE PM.PAYMENT_STATUS = 'SUCCESS';

